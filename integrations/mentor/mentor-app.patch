+export function takeFecoReturn(): { code: string | null; error: string | null } {
+  const params = new URLSearchParams(window.location.search);
+  const code = params.get("feco_code");
+  const error = params.get("feco_error");
+  if (code === null && error === null) return { code: null, error: null };
