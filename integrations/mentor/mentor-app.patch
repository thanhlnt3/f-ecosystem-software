@@ -0,0 +1,84 @@
+// "Sign in with F-Eco" (F-Eco change `mentor-integration`): the button, the one-time code on the way back, errors.
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { MemoryRouter } from "react-router-dom";
+import i18n from "./i18n";
+import { App } from "./App";
+import { AuthProvider, takeFecoReturn } from "./state/auth";
+import { api, fecoLoginUrl } from "./api";
+
+function renderApp() {
+  return render(
+    <MemoryRouter>
+      <AuthProvider>
+        <App />
+      </AuthProvider>
+    </MemoryRouter>,
+  );
+}
+
+function at(search: string) {
+  window.history.replaceState(null, "", "/" + search + "#/");
+}
+
+describe("sign in with F-Eco", () => {
+  beforeEach(async () => {
+    await i18n.changeLanguage("vi");
+    localStorage.clear();
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    at("");
+  });
+
+  it("shows the button only when the gateway has F-Eco sign-in on", async () => {
+    renderApp();
+    await screen.findByRole("radiogroup");
+    expect(screen.queryByRole("button", { name: "Đăng nhập bằng F-Eco" })).toBeNull();
+  });
+
+  it("the button sends the browser to the gateway with this app's origin to come back to", async () => {
+    vi.spyOn(api, "fecoStatus").mockResolvedValue({ enabled: true });
+    const assign = vi.fn();
+    vi.spyOn(window, "location", "get").mockReturnValue({ ...window.location, origin: "http://tauri.localhost", assign } as Location);
+    const ui = userEvent.setup();
+    renderApp();
+    await ui.click(await screen.findByRole("button", { name: "Đăng nhập bằng F-Eco" }));
+    expect(assign).toHaveBeenCalledWith(fecoLoginUrl("http://tauri.localhost"));
+    expect(fecoLoginUrl("http://tauri.localhost")).toMatch(/\/auth\/feco\/login\?return=http%3A%2F%2Ftauri\.localhost$/);
+  });
+
+  it("trades the one-time code for a session and removes it from the address bar", async () => {
+    at("?feco_code=mock-feco&x=1");
+    const exchange = vi.spyOn(api, "fecoExchange");
+    renderApp();
+    await waitFor(() => expect(screen.queryByRole("radiogroup")).toBeNull());
+    expect(exchange).toHaveBeenCalledWith("mock-feco");
+    expect(window.location.search).toBe("?x=1");
+    expect(localStorage.length).toBeGreaterThan(0); // the session token is saved like a password login
+  });
+
+  it("a used or expired code shows a message on the sign-in screen", async () => {
+    at("?feco_code=used-code");
+    renderApp();
+    expect(await screen.findByRole("alert")).toHaveTextContent("Mã đăng nhập F-Eco đã hết hạn. Thử lại nhé.");
+    expect(window.location.search).toBe("");
+  });
+
+  it("an error from the gateway is shown; an unknown one falls back to the generic message", async () => {
+    at("?feco_error=feco_denied");
+    const { unmount } = renderApp();
+    expect(await screen.findByRole("alert")).toHaveTextContent("Bạn đã hủy đăng nhập bằng F-Eco.");
+    unmount();
+    at("?feco_error=<script>");
+    renderApp();
+    expect(await screen.findByRole("alert")).toHaveTextContent("Đăng nhập bằng F-Eco không thành công. Thử lại nhé.");
+  });
+
+  it("takeFecoReturn leaves other addresses alone", () => {
+    at("?x=1");
+    expect(takeFecoReturn()).toEqual({ code: null, error: null });
+    expect(window.location.search).toBe("?x=1");
+  });
+});
