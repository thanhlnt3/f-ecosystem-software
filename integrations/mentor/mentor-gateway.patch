diff --git a/services/gateway/src/mentor_gateway/api/feco_auth.py b/services/gateway/src/mentor_gateway/api/feco_auth.py
new file mode 100644
index 0000000..0b3e75f
--- /dev/null
+++ b/services/gateway/src/mentor_gateway/api/feco_auth.py
@@ -0,0 +1,176 @@
+"""Sign in with an F-Eco account: `/api/auth/feco/*`.
+
+OIDC authorization code + PKCE with a confidential client. Authlib does the OAuth part (state, nonce, PKCE, code
+exchange with the client secret, ID token signature through the issuer's JWKS); its state lives in a short signed
+cookie (Starlette `SessionMiddleware`, see `app.py`).
+
+1. The app (web or desktop webview) or F-Launcher opens `GET /api/auth/feco/login?return=<app origin>`.
+2. F-Eco signs the person in and returns to `GET /api/auth/feco/callback`.
+3. The callback finds the Mentor account linked to the F-Eco subject, or creates a student account, and sends the
+   browser back to `<app origin>/?feco_code=<one-time code>` (or `?feco_error=<code>`).
+4. The app trades the code for the usual session token: `POST /api/auth/feco/exchange`.
+
+The return address must be one of the gateway's allowed origins (`Settings.allowed_origins`: the web app, the Tauri
+webviews, `CORS_ORIGINS`), so the code cannot be sent anywhere else. Teacher accounts are never created here: an
+admin promotes an account with `python -m mentor_gateway.cli set-role`.
+"""
+
+import hashlib
+import logging
+import secrets
+from datetime import timedelta
+from urllib.parse import urlencode
+
+from authlib.integrations.starlette_client import OAuth, OAuthError
+from fastapi import APIRouter, Depends, Request
+from fastapi.responses import JSONResponse, RedirectResponse
+from pydantic import BaseModel, Field
+from sqlalchemy import delete
+from sqlalchemy.exc import IntegrityError
+
+from mentor_gateway.api.auth import issue_session
+from mentor_gateway.api.deps import get_gw
+from mentor_gateway.context import Gateway
+from mentor_gateway.db import FecoLoginCode, User
+from mentor_gateway.security import hash_token, new_token
+from mentor_gateway.settings import Settings
+
+log = logging.getLogger(__name__)
+router = APIRouter(prefix="/auth/feco", tags=["auth"])
+
+_SESSION_SECRET: dict[int, str] = {}
+
+
+def session_secret(settings: Settings) -> str:
+    """FECO_SESSION_SECRET, or a random secret for this process (a login started before a restart then fails
+    with `feco_state` and the person simply tries again)."""
+    if settings.feco_session_secret:
+        return settings.feco_session_secret
+    return _SESSION_SECRET.setdefault(id(settings), secrets.token_urlsafe(32))
+
+
+def _oauth(request: Request):
+    """The registered Authlib client, or None when F-Eco sign-in is off."""
+    settings: Settings = request.app.state.gw.settings
+    if not settings.feco_enabled:
+        return None
+    oauth = getattr(request.app.state, "feco_oauth", None)
+    if oauth is None:
+        oauth = OAuth()
+        oauth.register(
+            name="feco",
+            client_id=settings.feco_client_id,
+            client_secret=settings.feco_client_secret,
+            server_metadata_url=settings.feco_issuer_url.rstrip("/") + "/.well-known/openid-configuration",
+            client_kwargs={
+                "scope": "openid profile",
+                "code_challenge_method": "S256",
+                "token_endpoint_auth_method": "client_secret_basic",
+            },
+        )
+        request.app.state.feco_oauth = oauth
+    return oauth.create_client("feco")
+
+
+def _return_origin(settings: Settings, value: str | None) -> str | None:
+    origin = (value or settings.web_url).strip().rstrip("/")
+    return origin if origin in settings.allowed_origins else None
+
+
+def _back(origin: str, **params: str) -> RedirectResponse:
+    return RedirectResponse(origin + "/?" + urlencode(params), status_code=303)
+
+
+@router.get("/status")
+def status(gw: Gateway = Depends(get_gw)) -> dict:
+    """Whether the sign-in screen shows "Sign in with F-Eco"."""
+    return {"enabled": gw.settings.feco_enabled}
+
+
+@router.get("/login", response_model=None)
+async def login(request: Request, gw: Gateway = Depends(get_gw)) -> RedirectResponse | JSONResponse:
+    origin = _return_origin(gw.settings, request.query_params.get("return"))
+    if origin is None:
+        return JSONResponse({"error": "bad_return"}, status_code=400)
+    client = _oauth(request)
+    if client is None:
+        return _back(origin, feco_error="feco_disabled")
+    request.session.clear()
+    request.session["feco_return"] = origin
+    try:
+        return await client.authorize_redirect(request, gw.settings.feco_callback_url)
+    except Exception:  # F-Eco unreachable (discovery document)
+        log.exception("F-Eco sign-in: authorize redirect failed")
+        return _back(origin, feco_error="feco_unavailable")
+
+
+@router.get("/callback", response_model=None)
+async def callback(request: Request, gw: Gateway = Depends(get_gw)) -> RedirectResponse | JSONResponse:
+    started = request.session.get("feco_return")  # set by /login; absent = not started here, or older than 10 min
+    origin = _return_origin(gw.settings, started) if started else None
+    client = _oauth(request)
+    if origin is None or client is None:
+        return JSONResponse({"error": "feco_state"}, status_code=400)
+    if request.query_params.get("error"):  # the person declined, or F-Eco refused the request
+        request.session.clear()
+        return _back(origin, feco_error="feco_denied")
+    try:
+        token = await client.authorize_access_token(request)
+    except OAuthError as exc:
+        log.warning("F-Eco sign-in failed: %s", exc.error)
+        request.session.clear()
+        return _back(origin, feco_error="feco_state" if exc.error == "mismatching_state" else "feco_failed")
+    request.session.clear()
+    subject = str((token.get("userinfo") or {}).get("sub") or "")
+    if not subject:
+        return _back(origin, feco_error="feco_failed")
+    name = ""
+    try:
+        me = await client.get(gw.settings.feco_server_url.rstrip("/") + "/v1/me", token=token)
+        if me.status_code == 200:
+            name = str(me.json().get("name") or "").strip()
+    except Exception:  # the name is only a nicety; the account works without it
+        log.warning("F-Eco sign-in: GET /v1/me failed", exc_info=True)
+    user = _account(gw, subject, name)
+    code = new_token()
+    now = gw.clock()
+    with gw.db.session() as s:
+        s.execute(delete(FecoLoginCode).where(FecoLoginCode.expires_at <= now))  # codes nobody traded
+        s.add(FecoLoginCode(code_hash=hash_token(code), user_id=user.id,
+                            expires_at=now + timedelta(seconds=gw.settings.feco_code_seconds)))
+    return _back(origin, feco_code=code)
+
+
+def _account(gw: Gateway, subject: str, name: str) -> User:
+    """The account linked to this F-Eco subject; a new student account on the first sign-in."""
+    user = gw.users.by_feco_subject(subject)
+    if user is not None:
+        return user
+    username = "feco-" + hashlib.sha256(subject.encode()).hexdigest()[:12]
+    try:
+        user = gw.users.create(username=username, password=secrets.token_urlsafe(32), role="student",
+                               display_name=(name or "F-Eco")[:200])
+        return gw.users.update(user.id, feco_subject=subject)
+    except IntegrityError:  # two first sign-ins at once: the other one created it
+        found = gw.users.by_feco_subject(subject) or gw.users.by_username(username)
+        if found is None:
+            raise
+        return found
+
+
+class ExchangeBody(BaseModel):
+    code: str = Field(min_length=10, max_length=200)
+
+
+@router.post("/exchange", response_model=None)
+async def exchange(body: ExchangeBody, gw: Gateway = Depends(get_gw)) -> dict | JSONResponse:
+    """One-time code from the callback -> `{token, user}` like `/api/auth/login`. A code works once."""
+    with gw.db.session() as s:
+        row = s.get(FecoLoginCode, hash_token(body.code))
+        if row is not None:
+            s.delete(row)
+        valid = row is not None and row.expires_at > gw.clock()
+        user = s.get(User, row.user_id) if valid else None
+    if user is None:
+        return JSONResponse({"error": "invalid_code"}, status_code=401)
+    return await issue_session(gw, user)
