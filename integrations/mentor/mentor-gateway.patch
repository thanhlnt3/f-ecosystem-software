@@ -0,0 +1,210 @@
+"""Sign in with an F-Eco account (`/api/auth/feco/*`, F-Eco change `mentor-integration`).
+
+F-Eco itself is replaced by a fake Authlib client: these tests cover what Mentor does with the result (return
+address whitelist, account mapping, one-time code). The OIDC round trip against a real F-Eco runs in the F-Eco
+repository (integrations/mentor/README.md).
+"""
+
+from urllib.parse import parse_qs, urlsplit
+
+import pytest
+from authlib.integrations.starlette_client import OAuthError
+from fastapi.responses import RedirectResponse
+from fastapi.testclient import TestClient
+
+from mentor_gateway.api import feco_auth
+from mentor_gateway.app import create_app
+from mentor_gateway.cli import main as cli_main
+from mentor_gateway.db import FecoLoginCode, User, WebSession
+
+
+class FakeResponse:
+    def __init__(self, status_code: int, body: dict):
+        self.status_code = status_code
+        self._body = body
+
+    def json(self) -> dict:
+        return self._body
+
+
+class FakeFeco:
+    """Stands in for the registered Authlib client: `subject` is who signs in at F-Eco."""
+
+    def __init__(self):
+        self.subject = "pairwise-sub-1"
+        self.name = "Nguyễn Văn An"
+        self.fail: str | None = None
+        self.me_status = 200
+        self.redirect_uri: str | None = None
+
+    async def authorize_redirect(self, request, redirect_uri):
+        self.redirect_uri = redirect_uri
+        request.session["_state_feco_x"] = {"data": {"code_verifier": "v"}}
+        return RedirectResponse("https://feco.test/oauth2/auth?state=x", status_code=302)
+
+    async def authorize_access_token(self, request):
+        if self.fail:
+            raise OAuthError(error=self.fail)
+        return {"access_token": "at", "userinfo": {"sub": self.subject}}
+
+    async def get(self, url, token=None):
+        assert url == "http://feco.test:8080/v1/me" and token["access_token"] == "at"
+        return FakeResponse(self.me_status, {"name": self.name})
+
+
+@pytest.fixture
+def feco_settings(settings):
+    return settings.model_copy(update={
+        "feco_client_id": "mentor-client", "feco_client_secret": "test-secret",
+        "feco_server_url": "http://feco.test:8080/", "extra_origins": "http://other.test",
+    })
+
+
+@pytest.fixture
+def fake(monkeypatch) -> FakeFeco:
+    f = FakeFeco()
+    monkeypatch.setattr(feco_auth, "_oauth", lambda request: f if request.app.state.gw.settings.feco_enabled else None)
+    return f
+
+
+@pytest.fixture
+def fclient(feco_settings, clock, executor, fake):
+    with TestClient(create_app(feco_settings, clock=clock, executor=executor)) as c:
+        yield c
+
+
+def _sign_in(client, origin="http://web.test") -> dict:
+    """login -> callback; returns the query of the redirect back to the app."""
+    r = client.get("/api/auth/feco/login", params={"return": origin}, follow_redirects=False)
+    assert r.status_code == 302 and r.headers["location"].startswith("https://feco.test/"), r.text
+    r = client.get("/api/auth/feco/callback", params={"code": "c", "state": "x"}, follow_redirects=False)
+    assert r.status_code == 303, r.text
+    loc = urlsplit(r.headers["location"])
+    assert f"{loc.scheme}://{loc.netloc}" == origin and loc.path == "/"
+    return {k: v[0] for k, v in parse_qs(loc.query).items()}
+
+
+def test_status_reports_whether_feco_sign_in_is_on(client, fclient):
+    assert client.get("/api/auth/feco/status").json() == {"enabled": False}
+    assert fclient.get("/api/auth/feco/status").json() == {"enabled": True}
+
+
+def test_first_sign_in_creates_a_student_and_the_code_works_once(fclient, fake):
+    q = _sign_in(fclient)
+    assert set(q) == {"feco_code"}
+    assert fake.redirect_uri == "http://testserver/api/auth/feco/callback"
+    r = fclient.post("/api/auth/feco/exchange", json={"code": q["feco_code"]})
+    assert r.status_code == 200, r.text
+    body = r.json()
+    assert body["user"]["role"] == "student" and body["user"]["display_name"] == "Nguyễn Văn An"
+    assert body["user"]["username"].startswith("feco-")
+    me = fclient.get("/api/me", headers={"Authorization": f"Bearer {body['token']}"})
+    assert me.status_code == 200 and me.json()["id"] == body["user"]["id"]
+    # the code is single-use
+    again = fclient.post("/api/auth/feco/exchange", json={"code": q["feco_code"]})
+    assert again.status_code == 401 and again.json() == {"error": "invalid_code"}
+    gw = fclient.app.state.gw
+    user = gw.users.by_feco_subject(fake.subject)
+    assert user is not None and user.provisioned_at is not None  # workspace created like a password login
+
+
+def test_next_sign_in_uses_the_linked_account(fclient, fake):
+    first = fclient.post("/api/auth/feco/exchange", json={"code": _sign_in(fclient)["feco_code"]}).json()
+    fake.name = "Tên mới"
+    second = fclient.post("/api/auth/feco/exchange", json={"code": _sign_in(fclient)["feco_code"]}).json()
+    assert second["user"]["id"] == first["user"]["id"]
+    fake.subject = "pairwise-sub-2"
+    third = fclient.post("/api/auth/feco/exchange", json={"code": _sign_in(fclient)["feco_code"]}).json()
+    assert third["user"]["id"] != first["user"]["id"]
+
+
+def test_teacher_linked_account_signs_in_as_teacher(fclient, fake):
+    gw = fclient.app.state.gw
+    teacher = gw.users.by_username("giaovien")
+    gw.users.update(teacher.id, feco_subject=fake.subject)
+    body = fclient.post("/api/auth/feco/exchange", json={"code": _sign_in(fclient)["feco_code"]}).json()
+    assert body["user"]["id"] == teacher.id and body["user"]["role"] == "teacher"
+
+
+def test_return_address_must_be_an_allowed_origin(fclient):
+    for bad in ("https://evil.test", "http://web.test.evil.test", "javascript:alert(1)"):
+        r = fclient.get("/api/auth/feco/login", params={"return": bad}, follow_redirects=False)
+        assert r.status_code == 400 and r.json() == {"error": "bad_return"}, bad
+    # the Tauri webview, CORS_ORIGINS and the web app (default) are allowed
+    assert "feco_code" in _sign_in(fclient, "http://tauri.localhost")
+    assert "feco_code" in _sign_in(fclient, "http://other.test")
+    r = fclient.get("/api/auth/feco/login", follow_redirects=False)
+    assert r.status_code == 302
+
+
+def test_callback_without_a_started_login_is_refused(fclient):
+    r = fclient.get("/api/auth/feco/callback", params={"code": "c", "state": "x"}, follow_redirects=False)
+    assert r.status_code == 400 and r.json() == {"error": "feco_state"}
+
+
+def test_errors_go_back_to_the_app(fclient, fake):
+    fclient.get("/api/auth/feco/login", params={"return": "http://web.test"}, follow_redirects=False)
+    r = fclient.get("/api/auth/feco/callback", params={"error": "access_denied"}, follow_redirects=False)
+    assert r.headers["location"] == "http://web.test/?feco_error=feco_denied"
+    fake.fail = "mismatching_state"
+    fclient.get("/api/auth/feco/login", params={"return": "http://web.test"}, follow_redirects=False)
+    r = fclient.get("/api/auth/feco/callback", params={"code": "c", "state": "y"}, follow_redirects=False)
+    assert r.headers["location"] == "http://web.test/?feco_error=feco_state"
+    fake.fail = "invalid_grant"
+    fclient.get("/api/auth/feco/login", params={"return": "http://web.test"}, follow_redirects=False)
+    r = fclient.get("/api/auth/feco/callback", params={"code": "c", "state": "x"}, follow_redirects=False)
+    assert r.headers["location"] == "http://web.test/?feco_error=feco_failed"
+
+
+def test_profile_name_is_optional(fclient, fake):
+    fake.me_status = 500
+    body = fclient.post("/api/auth/feco/exchange", json={"code": _sign_in(fclient)["feco_code"]}).json()
+    assert body["user"]["display_name"] == "F-Eco"
+
+
+def test_expired_code_is_refused_and_cleaned_up(fclient, fake, clock):
+    code = _sign_in(fclient)["feco_code"]
+    clock.advance(minutes=3)
+    r = fclient.post("/api/auth/feco/exchange", json={"code": code})
+    assert r.status_code == 401
+    old = _sign_in(fclient)["feco_code"]
+    clock.advance(minutes=3)
+    _sign_in(fclient)  # a new callback removes codes nobody traded
+    gw = fclient.app.state.gw
+    with gw.db.session() as s:
+        assert s.query(FecoLoginCode).count() == 1
+    assert fclient.post("/api/auth/feco/exchange", json={"code": old}).status_code == 401
+
+
+def test_disabled_without_client(client):
+    r = client.get("/api/auth/feco/login", params={"return": "http://web.test"}, follow_redirects=False)
+    assert r.headers["location"] == "http://web.test/?feco_error=feco_disabled"
+
+
+def test_password_login_still_works(fclient):
+    r = fclient.post("/api/auth/login", json={"username": "hocsinh", "password": "123456", "role": "student"})
+    assert r.status_code == 200
+
+
+def test_cli_set_role_promotes_and_ends_sessions(fclient, fake, feco_settings, capsys):
+    body = fclient.post("/api/auth/feco/exchange", json={"code": _sign_in(fclient)["feco_code"]}).json()
+    username = body["user"]["username"]
+    cli_main(["set-role", "--username", username, "--role", "teacher"], settings=feco_settings)
+    assert '"role": "teacher"' in capsys.readouterr().out
+    gw = fclient.app.state.gw
+    with gw.db.session() as s:
+        assert s.query(WebSession).filter(WebSession.user_id == body["user"]["id"]).count() == 0
+        assert s.get(User, body["user"]["id"]).role == "teacher"
+    again = fclient.post("/api/auth/feco/exchange", json={"code": _sign_in(fclient)["feco_code"]}).json()
+    assert again["user"]["role"] == "teacher"
+    with pytest.raises(SystemExit):
+        cli_main(["set-role", "--username", "nobody", "--role", "teacher"], settings=feco_settings)
+
+
+def test_settings_from_env():
+    from mentor_gateway.settings import Settings
+
+    s = Settings.from_env({"FECO_CLIENT_ID": "id", "FECO_CLIENT_SECRET": "sec", "PUBLIC_BASE_URL": "http://localhost:8100",
+                           "FECO_ISSUER_URL": "http://127.0.0.1:4444/"})
+    assert s.feco_enabled and s.feco_callback_url == "http://localhost:8100/api/auth/feco/callback"
+    assert not Settings.from_env({"FECO_CLIENT_ID": "id"}).feco_enabled
