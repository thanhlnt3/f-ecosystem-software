-﻿from fastapi import HTTPException, status
+﻿import secrets
+from typing import Any, Dict
+
+from fastapi import HTTPException, status
 from sqlalchemy.orm import Session
 from app.models.user import User
 from app.schemas.auth import UserRegisterRequest, UserLoginRequest, TokenResponse, UserResponse
@@ -57,5 +60,50 @@ class AuthService:
             user=UserResponse.model_validate(user),
         )
 
+    def login_with_feco(self, db: Session, subject: str, profile: Dict[str, Any]) -> str:
+        """Đăng nhập bằng tài khoản F-Eco và trả về JWT của ThesisAI.
+
+        `subject` là `sub` (pairwise) trong ID token đã kiểm chữ ký; `profile` là kết quả
+        `GET /v1/me` của F-Eco (tên, email, email_verified).
+        """
+        user = user_repo.get_by_feco_subject(db, subject)
+        if user is None:
+            email = str(profile.get("email") or "").strip().lower()
+            if not email:
+                raise HTTPException(
+                    status_code=status.HTTP_400_BAD_REQUEST,
+                    detail="F-Eco chưa chia sẻ email nên ThesisAI không tạo được tài khoản.",
+                )
+            user = user_repo.get_by_email(db, email)
+            if user is not None:
+                # Chỉ liên kết tài khoản có sẵn khi F-Eco xác nhận email là của người dùng.
+                if not profile.get("email_verified"):
+                    raise HTTPException(
+                        status_code=status.HTTP_409_CONFLICT,
+                        detail="Email này đã có tài khoản ThesisAI. Hãy xác minh email trên F-Eco "
+                        "rồi thử lại, hoặc đăng nhập bằng mật khẩu.",
+                    )
+            else:
+                name = str(profile.get("name") or "").strip() or email.split("@")[0]
+                # Mật khẩu ngẫu nhiên không ai biết: tài khoản này đăng nhập qua F-Eco.
+                user = user_repo.create(
+                    db=db,
+                    name=name[:100],
+                    email=email,
+                    password_hash=hash_password(secrets.token_urlsafe(32)),
+                    role="student",
+                )
+            user.feco_subject = subject
+            db.commit()
+            db.refresh(user)
+        if not user.is_active:
+            raise HTTPException(
+                status_code=status.HTTP_401_UNAUTHORIZED,
+                detail="Tài khoản ThesisAI đã bị khóa.",
+            )
+        return create_access_token(
+            data={"sub": str(user.id), "email": user.email, "role": user.role}
+        )
+
 
 auth_service = AuthService()
