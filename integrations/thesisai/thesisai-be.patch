diff --git a/app/api/routes/feco_auth.py b/app/api/routes/feco_auth.py
new file mode 100644
index 0000000..4ba51fc
--- /dev/null
+++ b/app/api/routes/feco_auth.py
@@ -0,0 +1,75 @@
+"""Đăng nhập bằng tài khoản F-Eco (OIDC authorization code + PKCE, client phía máy chủ).
+
+Luồng: frontend `/auth/feco` -> GET /api/auth/feco/login -> F-Eco -> GET /api/auth/feco/callback
+-> frontend `/auth/feco#token=...`. Authlib lo phần OAuth: state, nonce, PKCE, đổi mã bằng client
+secret, kiểm chữ ký ID token qua JWKS.
+"""
+from urllib.parse import urlencode
+
+from authlib.integrations.starlette_client import OAuth, OAuthError
+from fastapi import APIRouter, Depends, HTTPException, Request, status
+from fastapi.responses import RedirectResponse
+from sqlalchemy.orm import Session
+
+from app.core.config import settings
+from app.db.session import get_db
+from app.services.auth_service import auth_service
+
+router = APIRouter(prefix="/auth/feco", tags=["Authentication"])
+
+oauth = OAuth()
+if settings.FECO_CLIENT_ID:
+    oauth.register(
+        name="feco",
+        client_id=settings.FECO_CLIENT_ID,
+        client_secret=settings.FECO_CLIENT_SECRET,
+        server_metadata_url=settings.FECO_ISSUER_URL.rstrip("/")
+        + "/.well-known/openid-configuration",
+        client_kwargs={
+            "scope": "openid profile email",
+            "code_challenge_method": "S256",
+            "token_endpoint_auth_method": "client_secret_basic",
+        },
+    )
+
+
+def _client():
+    client = oauth.create_client("feco")
+    if client is None:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail="Chưa bật đăng nhập bằng F-Eco (thiếu FECO_CLIENT_ID).",
+        )
+    return client
+
+
+def _to_frontend(**fragment: str) -> RedirectResponse:
+    # Token nằm trong fragment (#) nên không đi vào nhật ký máy chủ hay header Referer.
+    url = settings.FRONTEND_URL.rstrip("/") + "/auth/feco#" + urlencode(fragment)
+    return RedirectResponse(url, status_code=status.HTTP_303_SEE_OTHER)
+
+
+@router.get("/login", summary="Chuyển sang F-Eco để đăng nhập")
+async def feco_login(request: Request):
+    return await _client().authorize_redirect(request, settings.FECO_REDIRECT_URI)
+
+
+@router.get("/callback", summary="F-Eco chuyển về sau khi người dùng đăng nhập")
+async def feco_callback(request: Request, db: Session = Depends(get_db)):
+    client = _client()
+    try:
+        token = await client.authorize_access_token(request)
+    except OAuthError as e:
+        return _to_frontend(error=e.description or e.error or "Đăng nhập F-Eco thất bại.")
+    claims = token.get("userinfo") or {}
+    subject = claims.get("sub")
+    if not subject:
+        return _to_frontend(error="F-Eco không trả về mã người dùng.")
+    me = await client.get(settings.FECO_SERVER_URL.rstrip("/") + "/v1/me", token=token)
+    if me.status_code != 200:
+        return _to_frontend(error="Không đọc được thông tin tài khoản F-Eco.")
+    try:
+        access_token = auth_service.login_with_feco(db, subject, me.json())
+    except HTTPException as e:
+        return _to_frontend(error=str(e.detail))
+    return _to_frontend(token=access_token)
