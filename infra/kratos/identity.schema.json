{
  "$id": "https://f-eco.example/schemas/identity.default.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Người dùng F-Eco",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "maxLength": 320,
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true },
              "totp": { "account_name": true },
              "webauthn": { "identifier": true }
            },
            "verification": { "via": "email" },
            "recovery": { "via": "email" }
          }
        },
        "name": { "type": "string", "title": "Tên hiển thị", "maxLength": 100 },
        "locale": { "type": "string", "title": "Ngôn ngữ", "enum": ["vi", "en"], "default": "vi" }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
